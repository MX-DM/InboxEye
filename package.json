{
  "name": "inboxeye",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @inboxeye/api",
    "dev:web": "npm run dev -w @inboxeye/web",
