# Solo backend. Copiar a apps/api/.env (ignorado por git) y completar localmente.
ANTHROPIC_API_KEY=
# Modelo configurable; verificar el identificador vigente antes de usarlo.
ANTHROPIC_MODEL=claude-haiku-5-5
# Opcional: modelo del clasificador del Input Guard (por defecto, el mismo que ANTHROPIC_MODEL).
# ANTHROPIC_GUARD_MODEL=
PORT=3001
